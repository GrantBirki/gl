{
  "name": "g-and-l",
  "description": "Wedding website for Grant and Leah",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "bootstrap": "npm install && npm run astro sync && npm run astro check",
    "format": "prettier -w .",
    "format-ci": "prettier --check .",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.astro",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "all": "npm run format && npm run lint:eslint && npm run build"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.7",
    "@astrojs/partytown": "2.1.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.0",
    "@fontsource-variable/inter": "5.2.8",
    "@iconify-json/flat-color-icons": "1.2.3",
    "@iconify-json/icon-park": "1.2.4",
    "@iconify-json/ri": "1.2.9",
    "@iconify-json/tabler": "1.2.31",
    "@tailwindcss/typography": "0.5.19",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "@vitest/coverage-v8": "4.1.11",
    "astro": "7.2.8",
    "astro-icon": "1.2.0",
    "autoprefixer": "10.4.24",
    "eslint": "9.39.2",
    "eslint-plugin-astro": "1.6.0",

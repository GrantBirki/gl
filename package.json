    "image-size": "2.0.4",
    "limax": "4.2.2",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.12.3",
    "react-confetti": "6.4.0",
    "reading-time": "1.5.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
